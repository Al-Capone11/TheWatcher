{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "All Rights Reserved",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.josem.thewatcher.TheWatcherMod"
    ],
    "client": [
      "com.josem.thewatcher.client.TheWatcherFabricClient"
    ],
    "modmenu": [
      "com.josem.thewatcher.client.TheWatcherModMenuImpl"
    ]
  },
  "mixins": [
    "thewatcher.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "cloth-config": "*"
  }
}



